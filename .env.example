# Agentic RAG Pipeline — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env, fill in your real values, and NEVER commit .env to git.

# ── LLM Provider ─────────────────────────────────────────────────────────────

# Google Gemini API key — required for the LLM & embedding models.
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI API key — optional, required only if switching to an OpenAI-backed LLM.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection URI — optional, used for structured financial data storage.
# Format: postgresql://user:password@host:port/dbname
POSTGRES_URI=postgresql://user:password@localhost:5432/sec_filings

# ── Vector Store ─────────────────────────────────────────────────────────────

# Local directory where ChromaDB persists its collections.
CHROMA_PERSIST_DIR=./chroma_db
